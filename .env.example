# URL of the beets web plugin (must have readonly: no in beets config.yaml)
# Use the container name if beetjuice and beets share a Docker network (e.g. http://beets:8337)
BEETS_API_URL=http://beets:8337

# Path where the music library is mounted inside the beetjuice container.
# Must match the internal path your beets container uses for the same share so paths align.
MUSIC_PATH=/music

# Port beetjuice listens on
PORT=3001

# Unraid UID/GID (99/100 = nobody/users)
PUID=99
PGID=100

# URL of the beets web plugin (must have readonly: no in beets config.yaml)
# Use the container name if beetjuice and beets share a Docker network (e.g. http://beets:8337)
BEETS_API_URL=http://beets:8337

# Path where the music share is mounted inside the beetjuice container (the safety boundary for deletions).
MUSIC_PATH=/music

# Root of the beets library inside the container. Set this if beets returns relative paths
# (i.e. paths that don't start with /) or if beets uses a subdirectory of the music share.
# Example: if your music is at /music and beets' library is the "clean" subfolder, set this to /music/clean.
# If unset, defaults to MUSIC_PATH.
BEETS_LIBRARY_PATH=/music/clean

# Port beetjuice listens on
PORT=3001

# Unraid UID/GID (99/100 = nobody/users)
PUID=99
PGID=100
